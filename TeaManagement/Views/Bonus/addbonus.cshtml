@using TeaManagement.Controllers
@using TeaManagement.Manager
@model TeaManagement.ViewModels.NewBonusVm

@{
    ViewData["Title"] = "Add Bonus";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">   <!-- Controls card width -->
            <div class="card shadow-sm">
                <div class="card-header text-center">
                    <h5 class="mb-0">New Bonus Setup</h5>
                </div>

                <div class="card-body">
                    <form method="post" id="form" asp-action="AddBonus">
                        <div class="mb-3">
                            <label asp-for="Name">Bonus Name <strong class="text-danger">*</strong></label>
                            <input asp-for="Name" required="required" class="form-control"/>
                            <span asp-validation-for="Name"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EffectiveDate">Effective From <strong class="text-danger">*</strong></label>
                            <input asp-for="EffectiveDate" type="text" id="date" required="required"
                                   class="form-control"/>
                        </div>
                        <div class="mb-3">
                            <label asp-for="BonusPerKg">Bonus Per KG <strong class="text-danger">*</strong></label>
                            <input asp-for="BonusPerKg" type="number" required="required" class="form-control"/>
                        </div>


                        <div class="mb-3">
                            <label asp-for="FactoryId">Select Factory <strong class="text-danger">*</strong></label>
                            <select asp-for="FactoryId" required="required" id="factoryid" class="form-control">
                                <option>Select Factory..</option>
                                @if (Model.FactorySelectList != null)
                                {
                                    @foreach (var f in Model.FactorySelectList)
                                    {
                                        <option value="@f.Value">@f.Text</option>
                                    }
                                }

                            </select>
                        </div>
                        <div class="mb-3 form-check form-check-inline">
                            <label asp-for="IsNewLedger" class="form-check-label">Create Ledger</label>
                            <input type="checkbox" checked="checked" id="checkbox" class="form-check-input"
                                   asp-for="IsNewLedger"/>
                        </div>
                        <div class="mb-3">
                            <label asp-for="LedgerId" id="labelForLedgerId" style="display: none">Select Bonus Ledger</label>
                            <select asp-for="LedgerId" required="required" style="display: none" id="ledgerId"
                                    class="form-control">
                                <option>Select Ledger..</option>
                                @if (Model.BonusLedgerList != null)
                                {
                                    foreach (var l in Model.BonusLedgerList)
                                    {
                                        <option value="@l.Value">@l.Text</option>
                                    }
                                }

                            </select>
                        </div>

                        <div>
                            <button type="submit" class="btn btn-primary ">Save</button>
                            <button asp-action="AddBonus" formmethod="get" class="btn btn-danger">Reset</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let checkboxElm = document.getElementById('checkbox');
    checkboxElm.addEventListener('change', (event) => {
        const isChecked = checkboxElm.checked;

        let inputElm = document.getElementById("ledgerId");
        let labelElm = document.getElementById("labelForLedgerId");
        if (!isChecked) {
            inputElm.style.display = "block";
            labelElm.style.display = "block";
        } else {
            inputElm.style.display = "none";
            labelElm.style.display = "none";
        }


    })
</script>